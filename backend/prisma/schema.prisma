generator client {
  provider = "prisma-client"
  output = "../src/generated"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  GROUP_ADMIN
  BRAND_ADMIN
}

enum AttemptKind {
  LOGIN_SOURCE
  LOGIN_ACCOUNT
  REGISTER_SOURCE
}

model Account {
  id           String    @id @db.Uuid
  username     String    @unique @db.VarChar(32)
  passwordHash String
  displayName  String
  role         Role
  memberNumber String?   @unique @db.Uuid
  sessions     Session[]
  brandGrants  BrandAdminGrant[]
  pointAccounts PointAccount[]
  pointActions  PointLedger[]
  operations    IdempotentOperation[]
}

model Brand {
  id        String            @id @db.Uuid
  name      String            @db.VarChar(80)
  seedKey   String?           @unique
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  grants    BrandAdminGrant[]
  offers    CouponOffer[]
  pointAccounts PointAccount[]

  @@index([createdAt, id])
}

model CouponOffer {
  id          String    @id @db.Uuid
  brandId     String    @db.Uuid
  name        String    @db.VarChar(80)
  description String    @db.VarChar(500)
  points      Int
  startsAt    DateTime  @db.Timestamptz(3)
  endsAt      DateTime  @db.Timestamptz(3)
  stoppedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  vouchers    Voucher[]

  @@unique([brandId, id])
  @@index([brandId, createdAt, id])
}

model BrandAdminGrant {
  accountId String  @db.Uuid
  brandId   String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@id([accountId, brandId])
}

model Session {
  id        String    @id @db.Uuid
  accountId String    @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
}

model AttemptWindow {
  kind      AttemptKind
  key       String
  attempted DateTime[]  @db.Timestamptz(3)

  @@id([kind, key])
}

enum PointSource {
  SEED
  GRANT
  EXCHANGE
}

model PointAccount {
  brandId  String        @db.Uuid
  memberId String        @db.Uuid
  balance  Int           @default(0)
  brand    Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  member   Account       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  ledger   PointLedger[]

  @@id([brandId, memberId])
}

model PointLedger {
  id        String       @id @db.Uuid
  brandId   String       @db.Uuid
  memberId  String       @db.Uuid
  amount    Int
  reason    String?      @db.VarChar(200)
  source    PointSource
  actorId   String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  account   PointAccount @relation(fields: [brandId, memberId], references: [brandId, memberId], onDelete: Restrict)
  actor     Account      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  exchangeId String?    @default(dbgenerated()) @db.Uuid
  voucher    Voucher?   @relation("VoucherDebit")
  requiredVoucher Voucher? @relation("RequiredVoucher", fields: [brandId, memberId, exchangeId], references: [brandId, memberId, ledgerId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([brandId, memberId, exchangeId])
  @@index([brandId, memberId, createdAt, id])
}

model Voucher {
  id        String      @id @db.Uuid
  code      String      @unique @db.Uuid
  brandId   String      @db.Uuid
  memberId  String      @db.Uuid
  offerId   String      @db.Uuid
  ledgerId  String      @db.Uuid
  createdAt DateTime    @db.Timestamptz(3)
  offer     CouponOffer @relation(fields: [brandId, offerId], references: [brandId, id], onDelete: Restrict)
  ledger    PointLedger @relation("VoucherDebit", fields: [brandId, memberId, ledgerId], references: [brandId, memberId, exchangeId], onDelete: NoAction, onUpdate: NoAction)
  requiredBy PointLedger? @relation("RequiredVoucher")

  @@unique([brandId, memberId, ledgerId])
  @@index([memberId, createdAt, id])
}

model IdempotentOperation {
  id          String  @id @db.Uuid
  actorId     String  @db.Uuid
  key         String  @db.Uuid
  fingerprint String  @db.Char(64)
  status      Int?
  result      Json?
  actor       Account @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, key])
}
