generator client {
  provider = "prisma-client"
  output = "../src/generated"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  GROUP_ADMIN
  BRAND_ADMIN
}

enum AttemptKind {
  LOGIN_SOURCE
  LOGIN_ACCOUNT
  REGISTER_SOURCE
}

model Account {
  id           String    @id @db.Uuid
  username     String    @unique @db.VarChar(32)
  passwordHash String
  displayName  String
  role         Role
  memberNumber String?   @unique @db.Uuid
  sessions     Session[]
  brandGrants  BrandAdminGrant[]
  pointAccounts PointAccount[]
  pointActions  PointLedger[]
  operations    IdempotentOperation[]
}

model Brand {
  id        String            @id @db.Uuid
  name      String            @db.VarChar(80)
  seedKey   String?           @unique
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  grants    BrandAdminGrant[]
  pointAccounts PointAccount[]

  @@index([createdAt, id])
}

model BrandAdminGrant {
  accountId String  @db.Uuid
  brandId   String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@id([accountId, brandId])
}

model Session {
  id        String    @id @db.Uuid
  accountId String    @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
}

model AttemptWindow {
  kind      AttemptKind
  key       String
  attempted DateTime[]  @db.Timestamptz(3)

  @@id([kind, key])
}

enum PointSource {
  SEED
  GRANT
}

model PointAccount {
  brandId  String        @db.Uuid
  memberId String        @db.Uuid
  balance  Int           @default(0)
  brand    Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  member   Account       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  ledger   PointLedger[]

  @@id([brandId, memberId])
}

model PointLedger {
  id        String       @id @db.Uuid
  brandId   String       @db.Uuid
  memberId  String       @db.Uuid
  amount    Int
  reason    String       @db.VarChar(200)
  source    PointSource
  actorId   String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  account   PointAccount @relation(fields: [brandId, memberId], references: [brandId, memberId], onDelete: Restrict)
  actor     Account      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([brandId, memberId, createdAt, id])
}

model IdempotentOperation {
  id          String  @id @db.Uuid
  actorId     String  @db.Uuid
  key         String  @db.Uuid
  fingerprint String  @db.Char(64)
  status      Int?
  result      Json?
  actor       Account @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, key])
}
